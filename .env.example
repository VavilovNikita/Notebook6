# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

DB_USERNAME=user
DB_PASSWORD=change-me
DB_NAME=notebook

# Credentials for the built-in Spring Security default user (defense-in-depth fallback).
DEFAULT_ADMIN_USERNAME=user
DEFAULT_ADMIN_PASSWORD=change-me

# DeepSeek API key used by CodeSage / SubEditor translation features.
DEEPSEEK_API_KEY=change-me
